# Copy to .env and fill in values before running.

# PostgreSQL — asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/remittance_db

# Session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-running

# Set to true in development only
DEBUG=false

# Admin seed (used by: make seed-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Platform Admin
ADMIN_MOBILE=+27000000000

# XRPL key encryption key (32-byte hex) — keep separate from the DB
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
XRPL_ENCRYPTION_KEY=change-me-32-byte-hex-key-here

# Test database (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/remittance_test
