# Copy to .env and fill in values before running.

# PostgreSQL — asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/remittance_db

# Session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-running

# Set to true in development only
DEBUG=false

# Admin seed (used by: make seed-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Platform Admin
ADMIN_MOBILE=+27000000000

# Redis — queue backend (RQ)
REDIS_URL=redis://localhost:6379/0

# XRPL Testnet JSON-RPC endpoint
XRPL_JSON_RPC=https://s.altnet.rippletest.net:51234

# UCTUSD issuer / burn address — withdrawals send UCTUSD back here to burn it
XRPL_ISSUER_ADDRESS=rELez4x4Zqv3KYqboYVfrYPF8521Ycbxa5

# On-ledger currency code, read verbatim from AccountLines on the treasury wallet
# (see scripts/check_currency.py). 40-char hex = "UCTUSD". Never guess this value.
XRPL_CURRENCY_CODE=5543545553440000000000000000000000000000

# Platform treasury wallet — pre-funded with UCTUSD, signs outgoing payments
XRPL_PLATFORM_WALLET_ADDRESS=rMcBddj7AD6aEFoPSeSL8HpqVJMMxaezoz
# Treasury seed — controls all UCTUSD liquidity. Obtain from lecturer. NEVER commit.
XRPL_PLATFORM_WALLET_SEED=change-me-treasury-seed

# XRPL key encryption key (32-byte hex) — keep separate from the DB
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
XRPL_ENCRYPTION_KEY=change-me-32-byte-hex-key-here

# Test database (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/remittance_test

# --- FX rate source (Phase 4) ---
# "config" reads market_rate_zar_per_usd from the active fee_config row (default).
# "static" pins FX_STATIC_MARKET_RATE below, for offline demos and tests.
# A live FX API can be added inside fx_service.get_market_rate without changing callers.
FX_RATE_SOURCE=config
FX_STATIC_MARKET_RATE=18.50
